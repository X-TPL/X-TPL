# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real tokens or machine-specific paths.

# GitHub personal access token (classic, no extra scopes needed for public repos)
TOKEN=ghp_your_personal_access_token_here

# Storage roots for downloaded/extracted repositories, one per framework.
# Each framework's process_repos.py downloads into <path>/ and extracted
# repos end up in <path>/extracted/, which analyzer.py then reads from.
STORAGE_ROOT_FLUTTER=/home/ubuntu/storage/flutter_assets
STORAGE_ROOT_RN=/home/ubuntu/storage/rn_assets
STORAGE_ROOT_CORDOVA=/home/ubuntu/storage/cordova_assets
STORAGE_ROOT_MAUI=/home/ubuntu/storage/maui_assets
STORAGE_ROOT_UNITY=/home/ubuntu/storage/unity_assets
